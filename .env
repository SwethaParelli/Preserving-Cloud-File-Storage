# Environment configuration for Privacy-Preserving Cloud File Storage

# Flask Configuration
SECRET_KEY=super-secret-flask-session-key-change-in-production-128bit!
FLASK_ENV=development
PORT=5000

# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017/
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/
# If MongoDB is not running, the application will automatically fall back to an in-memory/mock database for seamless testing.
MONGO_URI=mongodb://localhost:27017/privacy_storage_db
MONGO_DB_NAME=privacy_storage_db

# AES-256 Master Key (Must be 32 bytes / 64 hex characters or 256-bit string)
# If left default or blank, a secure 256-bit master key is derived or generated automatically.
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AWS S3 Cloud Storage Configuration
# Set USE_S3=true to upload encrypted files to AWS S3.
# Set USE_S3=false to use local encrypted storage mode (saved securely in ./encrypted_storage).
USE_S3=false
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=privacy-preserving-file-storage-bucket

# File Upload Limits (in bytes) - Default: 50MB
MAX_CONTENT_LENGTH=52428800
